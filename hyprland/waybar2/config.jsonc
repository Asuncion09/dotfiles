{
    "layer": "top",
    "position": "top",
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "height": 32,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/apps",
        "group/hardware"
    ],
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "tooltip-format": "{capacity}%",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰢟",
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ]
        }
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "ghostty --class=com.floating.medium -e bluetui"
    },
    "network": {
        "format": "",
        "format-wifi": "󰖩",
        "format-ethernet": "",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "󰤭",
        "max-length": 50,
        "on-click": "nmrs-gui"
    },
    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": "󰸗 {:%a, %d %b %Y}",
        "format-alt-click": "click",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "custom/launcher": {
        "format": "",
        "on-click": "~/.config/rofi/launcher.sh",
        "tooltip": false
    },
    "custom/notify": {
        "format": "",
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    },
    "group/apps": {
        "orientation": "horizontal",
        "modules": [
            "tray",
            "custom/notify"
        ]
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "bluetooth",
            "network",
            "battery"
        ]
    }
}